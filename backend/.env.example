# API key for frontend-to-backend authentication (optional but recommended)
REDACTOR_API_KEY=

# Max upload size in MB
REDACTOR_MAX_FILE_SIZE_MB=50

# ML/NLP detection (requires spaCy model)
REDACTOR_ENABLE_ML=false

# Queue backend: memory (default) or redis
REDACTOR_QUEUE_BACKEND=memory

# Worker processes for in-memory queue
REDACTOR_MAX_WORKERS=2

# Comma-separated allowed frontend origins
REDACTOR_CORS_ORIGINS=http://localhost:3000

# Rate limit string, e.g. 10/minute
REDACTOR_RATE_LIMIT=10/minute
